# HRMS Backend Environment Variables (.env.example)
# Copy this file to .env and set the values appropriately.
# Do not commit real secrets.

# Preferred backend-scoped variables:
# Full SQLAlchemy URL (e.g., sqlite:///./data/hrms.db or sqlite:////absolute/path/hrms.db)
DATABASE_URL=

# OR provide a filesystem path for SQLite (will be converted to sqlite:/// URL automatically)
# Relative path example: data/hrms.db
# Absolute path example: /data/hrms/hrms.db
SQLITE_DB_PATH=

# Compatibility fallback:
# If your environment already sets frontend-scoped variables, the backend will also respect these:
# REACT_APP_DATABASE_URL=
# REACT_APP_SQLITE_DB_PATH=

# Notes:
# - For SQLite, ports are not applicable. Ensure the file path is valid and writable.
# - If using relative paths, they resolve from the backend working directory.
# - The backend will create the parent directory if it does not exist.
