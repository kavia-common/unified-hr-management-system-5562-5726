# Example environment variables for HRMS Backend
# Copy this file to `.env` and adjust values as needed. Do NOT commit your real .env.

# Full SQLAlchemy database URL. If set, takes precedence.
# Examples:
#   SQLite file (absolute): sqlite:////data/hrms/hrms.db
#   SQLite file (relative): sqlite:///./hrms.db
#   SQLite in-memory: sqlite:///:memory:
# DATABASE_URL=sqlite:///./hrms.db

# Alternatively, provide only a filesystem path for SQLite and the app will build the URL.
# If both DATABASE_URL and SQLITE_DB_PATH are unset, the app defaults to ./hrms.db in the working directory.
# SQLITE_DB_PATH=./hrms.db
