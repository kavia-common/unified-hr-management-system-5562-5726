# Example environment variables for HRMS Backend
# Copy this file to .env and set values as needed. Do not commit real secrets.

# Full SQLAlchemy database URL. If set, it overrides SQLITE_DB_PATH.
# Examples:
# - sqlite:///./hrms.db
# - sqlite:////absolute/path/to/hrms.db
# - sqlite:///:memory:
DATABASE_URL=

# Path to SQLite database file (used if DATABASE_URL is not provided).
# Example: hrms_data/hrms.db (relative) or /data/hrms.db (absolute)
SQLITE_DB_PATH=
