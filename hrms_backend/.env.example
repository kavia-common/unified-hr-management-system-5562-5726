# Example environment variables for HRMS backend (FastAPI)

# Full SQLAlchemy URL (takes precedence). Example for SQLite file:
# DATABASE_URL=sqlite:///./data/hrms.db

# Or provide a filesystem path to the SQLite database file:
# SQLITE_DB_PATH=./data/hrms.db

# Compatibility with provided container env (frontend-style var names)
# REACT_APP_DATABASE_URL=
# REACT_APP_SQLITE_DB_PATH=

# Server configuration (optional)
# HOST=0.0.0.0
# PORT=3001
# LOG_LEVEL=info

# Optional integration keys (never commit real values)
# REACT_APP_OPENAI_API_KEY=
